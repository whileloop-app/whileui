{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  // `src/web` needs the DOM lib and is compiled by tsconfig.web.json.
  "exclude": ["node_modules", "dist", "src/web"]
}
